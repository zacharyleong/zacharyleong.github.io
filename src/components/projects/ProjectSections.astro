---
import type { CollectionEntry } from 'astro:content';
import { Card } from '@eliancodes/brutal-ui';
import ProjectGrid from './ProjectGrid.astro';
import ProjectJumpCard from './ProjectJumpCard.astro';
import ProjectJumpLink from './ProjectJumpLink.astro';

interface Props {
  projects: CollectionEntry<'blog'>[];
}

const { projects } = Astro.props;

const categories = [
  { id: 'graphics-programming', label: 'Graphics Programming' },
  { id: 'animation', label: 'Animation' },
  { id: 'games', label: 'Games' },
] as const;
---

<div class='mb-10'>
  <ProjectJumpCard
    links={categories.map(({ id, label }) => ({ href: `#${id}`, label }))}
  />
</div>

<div class='grid gap-12'>
  {categories.map(({ id, label }, index) => {
    const categoryProjects = projects.filter(({ data }) => data.category === id);
    const otherCategories = categories.filter((_, categoryIndex) => {
      if (categoryIndex === index) return false;
      return index !== categories.length - 1 || categoryIndex !== 0;
    });

    return (
      <section id={id} class='project-category scroll-mt-6'>
        <Card>
          <h2 class='project-section-heading mb-8 dm-serif'>
            <a class='category-heading-link' href={`#${id}`}>{label}</a>
          </h2>
          <ProjectGrid projects={categoryProjects} />

          <nav aria-label={`${label} category navigation`} class='category-pagination'>
            {otherCategories.map((category) => (
              <ProjectJumpLink
                href={`#${category.id}`}
                label={category.label}
                direction={categories.indexOf(category) < index ? 'previous' : 'next'}
              />
            ))}
            {index === categories.length - 1 && (
              <ProjectJumpLink href='#' label='Back to top' direction='top' />
            )}
          </nav>
        </Card>
      </section>
    );
  })}
</div>

<style>
  .category-heading-link {
    color: inherit;
  }

  .category-heading-link:hover,
  .category-heading-link:focus-visible {
    text-decoration: underline;
  }

  .category-pagination {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  @media (max-width: 767px) {
    .category-pagination {
      grid-template-columns: 1fr;
    }
  }
</style>
