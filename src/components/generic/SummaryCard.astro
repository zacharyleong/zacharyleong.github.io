---
import { Card } from '@eliancodes/brutal-ui';
import { Image } from 'astro:assets';

interface Props {
  title: string;
  imgSrc: ImageMetadata;
  imgAlt: string;
  description: string;
}

const { title, imgAlt, imgSrc, description } = Astro.props;
---

<Card color='white'>
  <h3 class='poppins text-lg md:text-xl'>{title}</h3>
  <div class='project-image-frame rounded-lg border-3 border-black my-4 h-56 overflow-hidden bg-black'>
    <Image
      src={imgSrc}
      alt={imgAlt}
      width={800}
      height={400}
      class='project-image block object-cover'
    />
  </div>
  <p class='poppins'>{description}</p>
  <slot />
</Card>

<style>
  .project-image-frame {
    position: relative;
  }

  .project-image {
    position: absolute;
    inset: -1px;
    width: calc(100% + 2px);
    height: calc(100% + 2px);
    max-width: none;
  }
</style>
