---
import { getCollection } from 'astro:content';
import ProjectGrid from '../projects/ProjectGrid.astro';
import { Card } from '@eliancodes/brutal-ui';
import { Button } from '@eliancodes/brutal-ui';

interface Props {
  count?: number;
  filter?: string;
}

const { count, filter } = Astro.props;

const posts = await getCollection(
  'blog',
  ({ data }) => import.meta.env.DEV || !data.draft,
).then((posts) => {
  const filteredPosts = filter ? posts.filter(post => !post.data.title.includes(filter)) : posts;
  const sortedPosts = [...filteredPosts].sort((a, b) => {
  const orderA = a.data.projectOrder ?? Number.POSITIVE_INFINITY;
  const orderB = b.data.projectOrder ?? Number.POSITIVE_INFINITY;

  if (orderA !== orderB) return orderA - orderB;
    return b.data.pubDate.getTime() - a.data.pubDate.getTime();
  });
  return sortedPosts.slice(0, count ?? 3)
});
---

<section class='featured-projects highlight-card mt-8'>
  <Card>
    <div class='flex justify-between items-start'>
      <h2 class='text-2xl md:text-4xl lg:text-6xl mb-8 dm-serif'>
        Featured Projects
      </h2>
      <div class='projects-action hidden md:block'>
        <Button href='/projects/'>Go to projects &rarr;</Button>
      </div>
      <div class='projects-action block md:hidden'>
        <Button href='/projects/'>to projects</Button>
      </div>
    </div>
    <ProjectGrid projects={posts} />
  </Card>
</section>
