---
export interface ImageItem {
  src: string;
  alt?: string;
  thumb?: string;
  width?: number;
  height?: number;
  aspectRatio?: number;
  objectFit?: 'cover' | 'contain';
}

export interface ImageDetails {
  width?: number;
  height?: number;
  aspectRatio?: number;
  objectFit?: 'cover' | 'contain';
}

export interface Props {
  images?: ImageItem[];
  caption?: string;
  galleryId?: string;
  aspectRatio?: number;
  objectFit?: 'cover' | 'contain';
  layout?: 'grid' | 'horizontal' | 'vertical';
  details?: Record<string, ImageDetails>;
}

const {
  images = [],
  caption,
  galleryId,
  aspectRatio,
  objectFit = 'cover',
  layout = 'grid',
  details = {},
} = Astro.props;

const uid = galleryId ?? `gallery-${Math.random().toString(36).slice(2, 10)}`;
---

<!-- Load CSS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lightgallery@2.8.3/css/lightgallery-bundle.min.css" />

<figure
  class="gallery-wrapper"
  style={{
    '--gallery-object-fit': objectFit,
  }}
>
  <div id={uid} class={`image-gallery layout-${layout}`} data-layout={layout}>
    {
      images.map((img) => {
        return (
          <a
            class="gallery-item"
            href={img.src}
            data-sub-html={img.alt ? `<h4>${img.alt}</h4>` : undefined}
            data-aspect-ratio={img.aspectRatio ?? aspectRatio}
            data-width={img.width}
            data-height={img.height}
            data-object-fit={img.objectFit}
          >
            <img
              src={img.thumb ?? img.src}
              alt={img.alt ?? ''}
              loading="lazy"
              decoding="async"
            />
          </a>
        );
      })
    }
    <slot />
  </div>
  {caption && <figcaption class="gallery-caption">{caption}</figcaption>}
</figure>

<style>
  .gallery-wrapper {
    max-width: 1200px;
    margin: 2rem auto;
    --media-radius: var(--content-media-radius, 8px);
  }

  .gallery-caption {
    text-align: center;
    color: var(--caption-color, #666);
    font-size: var(--caption-font-size, 0.9rem);
    margin-top: 1rem;
    font-style: italic;
  }

  .image-gallery {
    margin: 0;
    padding: 0;
  }

  .image-gallery :global(.gallery-item) {
    margin: 0;
    padding: 0;
    cursor: pointer;
    overflow: hidden;
    border-radius: var(--media-radius);
    position: relative;
    text-decoration: none;
    display: block;
  }

  .image-gallery :global(.gallery-item img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: var(--gallery-object-fit, cover);
    border-radius: inherit;
    vertical-align: bottom;
    transition: opacity 0.2s ease;
  }

  .image-gallery :global(.gallery-item:hover img) {
    opacity: 0.9;
  }

  /* ---- Grid (justified) layout ---- */
  .layout-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 2px;
  }

  .layout-grid :global(.gallery-item) {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 200px;
    height: 220px;
  }

  @media (max-width: 768px) {
    .layout-grid :global(.gallery-item) {
      flex-basis: 150px;
      height: 180px;
    }
  }

  @media (max-width: 500px) {
    .layout-grid {
      gap: 2px;
    }

    .layout-grid :global(.gallery-item) {
      flex: 1 1 100% !important;
      height: auto !important;
      max-height: 400px;
      border-radius: 0;
    }

    .layout-grid :global(.gallery-item img) {
      object-fit: contain;
    }

    .layout-grid :global(.gallery-item:first-child) {
      border-top-left-radius: var(--media-radius);
      border-top-right-radius: var(--media-radius);
    }

    .layout-grid :global(.gallery-item:last-child) {
      border-bottom-left-radius: var(--media-radius);
      border-bottom-right-radius: var(--media-radius);
    }
  }

  /* ---- Horizontal layout ---- */
  .layout-horizontal {
    display: flex;
    flex-wrap: nowrap;
    gap: 2px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
  }

  .layout-horizontal :global(.gallery-item) {
    flex: 0 0 auto;
    height: 220px;
    width: auto;
  }

  .layout-horizontal :global(.gallery-item img) {
    height: 100%;
    width: auto;
    object-fit: cover;
  }

  @media (max-width: 768px) {
    .layout-horizontal :global(.gallery-item) {
      height: 180px;
    }
  }

  /* ---- Vertical layout ---- */
  .layout-vertical {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .layout-vertical :global(.gallery-item) {
    flex: none;
    height: auto;
    width: 100%;
  }

  .layout-vertical :global(.gallery-item img) {
    width: 100%;
    height: auto;
    max-height: 500px;
    object-fit: var(--gallery-object-fit, cover);
  }
</style>

<script is:inline define:vars={{ uid, details, aspectRatio }}>
  window.lgGalleries = window.lgGalleries || [];

  function initGallery() {
    var el = document.getElementById(uid);
    if (!el || el.dataset.lgInit) return;

    if (!window.lightGallery || !window.lgThumbnail) {
      setTimeout(initGallery, 100);
      return;
    }

    Array.from(el.querySelectorAll('img')).forEach(function (img) {
      var item = img.closest('.gallery-item');

      if (!item) {
        var parent = img.parentElement;
        var visibleChildren = parent
          ? Array.from(parent.children).filter(function (child) { return child.tagName !== 'SCRIPT'; })
          : [];
        var isPlainMarkdownImage =
          parent &&
          parent.parentElement === el &&
          parent.tagName === 'P' &&
          visibleChildren.length === 1;

        if (isPlainMarkdownImage) {
          item = document.createElement('a');
          parent.replaceWith(item);
          item.appendChild(img);
        } else {
          item = document.createElement('a');
          img.parentNode.insertBefore(item, img);
          item.appendChild(img);
        }

        item.classList.add('gallery-item');
        item.setAttribute('href', img.currentSrc || img.getAttribute('src') || '');

        var alt = img.getAttribute('alt');
        if (alt) item.setAttribute('data-sub-html', '<h4>' + alt + '</h4>');
      }

      img.removeAttribute('data-zoomable');

      var source = img.getAttribute('src') || '';
      var cleanSource = source.split('?')[0].split('#')[0];
      var fileName = cleanSource.split('/').pop();
      var imageDetails = details[source] || details[cleanSource] || details[fileName] || {};

      if (!item.dataset.aspectRatio && imageDetails.aspectRatio) {
        item.dataset.aspectRatio = imageDetails.aspectRatio;
      } else if (!item.dataset.aspectRatio && aspectRatio) {
        item.dataset.aspectRatio = aspectRatio;
      }
      if (!item.dataset.width && imageDetails.width) item.dataset.width = imageDetails.width;
      if (!item.dataset.height && imageDetails.height) item.dataset.height = imageDetails.height;

      var imageObjectFit = imageDetails.objectFit || item.dataset.objectFit;
      if (imageObjectFit) img.style.objectFit = imageObjectFit;
    });

    el.dataset.lgInit = 'true';

    var layout = el.dataset.layout || 'grid';
    var items = Array.from(el.querySelectorAll('.gallery-item'));
    var images = items.map(function (item) { return item.querySelector('img'); }).filter(Boolean);

    var loadedCount = 0;
    var totalImages = images.length;

    function calculateLayout() {
      if (layout !== 'grid') return;

      var containerWidth = el.offsetWidth;

      if (containerWidth < 500) {
        items.forEach(function (item) {
          item.style.flexGrow = '';
          item.style.flexBasis = '';
        });
        return;
      }

      var targetHeight = containerWidth < 768 ? 180 : 220;

      items.forEach(function (item) {
        var img = item.querySelector('img');
        if (!img) return;

        var ar;
        var provided = parseFloat(item.dataset.aspectRatio);

        if (provided) {
          ar = provided;
        } else {
          var pw = parseFloat(item.dataset.width);
          var ph = parseFloat(item.dataset.height);

          if (pw && ph) {
            ar = pw / ph;
          } else {
            var nw = img.naturalWidth || 400;
            var nh = img.naturalHeight || 300;
            ar = nw / nh;
          }
        }

        var idealWidth = targetHeight * ar;
        item.style.flexGrow = ar.toFixed(3);
        item.style.flexBasis = idealWidth + 'px';
      });
    }

    var needsLoading = items.some(function (item) {
      return !item.dataset.aspectRatio && (!item.dataset.width || !item.dataset.height);
    });

    if (needsLoading) {
      images.forEach(function (img) {
        if (img.complete && img.naturalWidth > 0) {
          loadedCount++;
        } else {
          img.addEventListener('load', function () {
            loadedCount++;
            if (loadedCount === totalImages) calculateLayout();
          });
          img.addEventListener('error', function () {
            loadedCount++;
            if (loadedCount === totalImages) calculateLayout();
          });
        }
      });

      if (loadedCount === totalImages) calculateLayout();
    } else {
      calculateLayout();
    }

    try {
      window.lightGallery(el, {
        selector: '.gallery-item',
        plugins: [window.lgThumbnail],
        speed: 400,
        thumbnail: true,
        animateThumb: true,
        showThumbByDefault: false,
        thumbWidth: 100,
        thumbHeight: '80px',
        thumbMargin: 5,
        download: false,
        mobileSettings: {
          controls: true,
          showCloseIcon: true,
          download: false,
        },
      });
    } catch (e) {
      console.error('Gallery init error:', e);
    }

    var resizeTimeout;
    window.addEventListener('resize', function () {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(calculateLayout, 250);
    });
  }

  window.lgGalleries.push(initGallery);
  if (window.lightGallery) {
    initGallery();
  } else {
    window.addEventListener('load', initGallery);
  }
</script>

<script is:inline>
  if (!window.lgScriptsLoaded) {
    window.lgScriptsLoaded = true;

    var scripts = [
      'https://cdn.jsdelivr.net/npm/lightgallery@2.8.3/lightgallery.umd.min.js',
      'https://cdn.jsdelivr.net/npm/lightgallery@2.8.3/plugins/thumbnail/lg-thumbnail.umd.min.js',
    ];

    var loaded = 0;
    scripts.forEach(function (src) {
      if (document.querySelector('script[src="' + src + '"]')) {
        loaded++;
        return;
      }

      var script = document.createElement('script');
      script.src = src;
      script.onload = function () {
        loaded++;
        if (loaded === scripts.length && window.lgGalleries) {
          window.lgGalleries.forEach(function (fn) { fn(); });
        }
      };
      script.onerror = function () {
        loaded++;
        if (loaded === scripts.length && window.lgGalleries) {
          window.lgGalleries.forEach(function (fn) { fn(); });
        }
      };
      document.head.appendChild(script);
    });
  }
</script>
