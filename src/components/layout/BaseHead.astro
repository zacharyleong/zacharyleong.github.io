---
import LocalFont from '../generic/LocalFont.astro';
import { ViewTransitions } from 'astro:transitions';
import { themes, themeStyles } from '../../config/theme';

interface Props {
  title: string;
  description: string;
  ogImage?: URL;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

if (Astro.props.ogImage === undefined) {
  Astro.props.ogImage = new URL('/v1/generate/og/default.png', Astro.url);
}

const { title, description, ogImage } = Astro.props;
---

<head>
  <style is:inline set:html={themeStyles} />
  <script is:inline define:vars={{ darkBackgrounds: themes.dark.backgrounds.page }} data-astro-rerun>
    (() => {
      let theme;
      try {
        theme = localStorage.getItem('theme');
      } catch {}
      if (theme !== 'light' && theme !== 'dark') {
        theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      document.documentElement.dataset.theme = theme;
      const pageBackground = darkBackgrounds[Math.floor(Math.random() * darkBackgrounds.length)];
      document.documentElement.style.setProperty('--theme-page-background', pageBackground);
    })();
  </script>
  <LocalFont />
  <meta charset='utf-8' />
  <meta name='viewport' content='width=device-width, initial-scale=1' />
  <meta name='generator' content={Astro.generator} />

  <link
    rel='alternate'
    href='https://zacharyleong.com/blog.xml'
    type='application/rss+xml'
  />

  <meta name='title' content={`Zachary Leong | ${title}`} />
  <meta name='description' content={description} />

  <meta property='og:type' content='website' />
  <meta property='og:url' content={canonicalURL} />
  <meta property='og:title' content={title} />
  <meta property='og:description' content={description} />
  <meta property='og:image' content={ogImage} />

  <link rel='canonical' href={canonicalURL} />
  <link rel='icon' type='image/svg' href='/favicon.svg' />

  <title>Zachary Leong | {title}</title>

  
  <ViewTransitions />
  
  <script defer src="https://cloud.umami.is/script.js" data-website-id="58f0d464-03af-4c08-9f1a-861b0a39287b"></script>

  <slot />
</head>
