---
interface Props {
  pageTitle?: string;
}

import { VIMEO_ID } from "../../globals";
import { HEADER_BREAKPOINTS } from "../../config/header";
import BrandLogo from "./BrandLogo.astro";

const navigationItems = [
  { name: 'PROJECTS', url: '/projects/' },
  { name: 'REEL', url: `https://vimeo.com/${VIMEO_ID}`},
  { name: 'ABOUT', url: '/about/' },
  { name : 'RESUME', url: '/pdf/resume/resume-public.pdf'}
];

const { pageTitle } = Astro.props;

const headerResponsiveStyles = `
  .brand-logo {
    display: block;
    width: 100%;
    font-size: 1rem;
  }

  .brand-logo svg { width: auto; }
  .brand-logo__horizontal { display: none; height: 0.672em; }
  .brand-logo__stacked { display: block; height: 1.727em; }

  @media (min-width: ${HEADER_BREAKPOINTS.smallHorizontal}px) {
    .site-brand-link { flex-basis: 7.625rem; }
    .brand-logo__horizontal { display: block; }
    .brand-logo__stacked { display: none; }
  }

  @media (min-width: ${HEADER_BREAKPOINTS.large}px) {
    .site-brand-link { flex-basis: 7.78rem; }
    .brand-logo { font-size: 3rem; }
    .brand-logo__horizontal { display: none; }
    .brand-logo__stacked { display: block; }
    .header-actions { gap: 2rem; }
    .header-nav-large { display: inline-block; }
    .header-nav-small { display: none; }
  }

  @media (min-width: ${HEADER_BREAKPOINTS.largeHorizontal}px) {
    .site-brand-link { flex-basis: 22.8125rem; }
    .brand-logo__horizontal { display: block; }
    .brand-logo__stacked { display: none; }
  }
`;
---

<style is:global set:html={headerResponsiveStyles} />

<header class="site-header border-b-4 border-black flex justify-between p-6 items-center">
  {pageTitle && <h1 class="hidden">{pageTitle}</h1>}

  <!-- Brand -->
  <a class="site-brand-link" href="/" title="Back to Home" aria-label="Zachary Leong — Back to Home">
    <BrandLogo />
  </a>


  <div class="header-actions flex items-center">
    <nav class="header-nav-large">
      <h2 class="hidden">Navigation</h2>
      <ul class="flex gap-8 poppins">
      {navigationItems.map(item => (
        <li>
          <a
            class="site-nav-link text-2xl font-medium hover:underline"
            href={item.url}
            title={`Go to ${item.name}`}
            target={item.name === 'REEL' || item.name === 'RESUME' ? '_blank' : '_self'}
          >
            {item.name}
          </a>
        </li>
      ))}
      </ul>
    </nav>

    <nav class="header-nav-small">
      <h2 class="hidden">Mobile Navigation</h2>
      <ul class="flex gap-4 poppins">
        <li><a href="/projects/">PROJECTS</a></li>
        <li><a href="/about/">ABOUT</a></li>
      </ul>
    </nav>

    <button class="theme-toggle" type="button" aria-label="Switch to dark theme" title="Switch to dark theme">
      <span class="theme-icon theme-icon-sun i-uil-sun" aria-hidden="true" />
      <span class="theme-icon theme-icon-moon i-uil-moon" aria-hidden="true" />
    </button>
  </div>
</header>

<script>
  import { themes, type ThemeName } from '../../config/theme';

  const colorTargets = (theme: ThemeName) => [
    {
      selector: '.highlight-card > .brutal-card',
      colors: themes[theme].cards.highlight.backgrounds,
      property: '--theme-highlight-card-background',
      unique: false,
    },
    {
      selector: '.project-category > .brutal-card',
      colors: themes[theme].cards.category.backgrounds,
      property: '--theme-category-card-background',
      unique: true,
    },
    {
      selector: '.project-tags .brutal-pill',
      colors: themes[theme].controls.tag.hover,
      property: '--theme-tag-hover',
      unique: false,
    },
    {
      selector: '.project-action .brutal-btn',
      colors: themes[theme].controls.projectButton.hover,
      property: '--theme-project-button-hover',
      unique: false,
    },
    {
      selector: '.projects-action .brutal-btn',
      colors: themes[theme].controls.projectsButton.hover,
      property: '--theme-projects-button-hover',
      unique: false,
    },
    {
      selector: '.random-accent',
      colors: themes[theme].controls.generic.hover,
      property: '--theme-generic-control-hover',
      unique: false,
    },
  ] as const;

  const colorIndexCache = new Map<string, number[]>();

  const applyRandomColors = (theme: ThemeName) => {
    colorTargets(theme).forEach(({ selector, colors, property, unique = false }) => {
      const usedIndices = new Set<number>();
      const cachedIndices = colorIndexCache.get(selector) ?? [];
      document.querySelectorAll<HTMLElement>(selector).forEach((element, elementIndex) => {
        const storedIndex = Number(element.dataset.themeColorIndex);
        const cachedIndex = cachedIndices[elementIndex];
        let index = Number.isInteger(cachedIndex)
          ? cachedIndex
          : Number.isInteger(storedIndex)
            ? storedIndex
            : Math.floor(Math.random() * colors.length);

        if (unique && usedIndices.has(index % colors.length)) {
          const availableIndices = colors.map((_, colorIndex) => colorIndex).filter((colorIndex) => !usedIndices.has(colorIndex));
          index = availableIndices[Math.floor(Math.random() * availableIndices.length)] ?? index;
        }

        usedIndices.add(index % colors.length);
        cachedIndices[elementIndex] = index;
        element.dataset.themeColorIndex = String(index);
        element.style.setProperty(property, colors[index % colors.length]);
      });
      colorIndexCache.set(selector, cachedIndices);
    });

    document.querySelectorAll<HTMLElement>('.project-category').forEach((section) => {
      const card = section.querySelector<HTMLElement>(':scope > .brutal-card');
      const color = card?.style.getPropertyValue('--theme-category-card-background');
      if (!section.id || !color) return;

      document.querySelectorAll<HTMLElement>(`a[href="#${section.id}"]`).forEach((link) => {
        link.style.setProperty('--project-section-color', color);
      });
    });
  };

  let transitionTimer: number | undefined;

  const applyTheme = (theme: ThemeName, persist = false) => {
    const root = document.documentElement;
    if (persist) {
      root.classList.add('theme-transitioning');
      window.clearTimeout(transitionTimer);
      transitionTimer = window.setTimeout(() => {
        root.classList.remove('theme-transitioning');
      }, 260);
    }
    root.dataset.theme = theme;
    applyRandomColors(theme);
    const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
    const nextTheme = theme === 'dark' ? 'light' : 'dark';
    toggle?.setAttribute('aria-label', `Switch to ${nextTheme} theme`);
    toggle?.setAttribute('title', `Switch to ${nextTheme} theme`);
    if (persist) {
      try {
        localStorage.setItem('theme', theme);
      } catch {}
    }
  };

  const initializeTheme = () => {
    const root = document.documentElement;
    const theme = (root.dataset.theme === 'dark' ? 'dark' : 'light') as ThemeName;
    applyTheme(theme);
    const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
    if (toggle) {
      toggle.onclick = () => applyTheme(root.dataset.theme === 'dark' ? 'light' : 'dark', true);
    }
  };

  document.addEventListener('astro:page-load', initializeTheme);
</script>
