---
import Layout from '@layouts/Default.astro';
import { Card } from '@eliancodes/brutal-ui';
import RecentBlogPosts from '@components/generic/RecentBlogPosts.astro';
import { email } from '@config';
---

<Layout
  title='About'
  description="About page | Learn about who I am"
  pageTitle="About Me"
>

  <main class='bg-green p-6'>
    <section id='about-me' class='grid md:grid-cols-8 gap-8 mt-4'>
        <img
            src="/img/mario_profile.jpg"
            alt="Photo of Zachary"
            class="col-span-2 card-shadow border-3 rounded-lg border-black"
            />

       <div class='col-span-6'>
           <Card>
             <h2 class="mt-4 outfit text-2xl md:text-5xl lg:text-7xl">Hi, I'm Zachary, </h2>
             <!-- <p class="mt-4 outfit text-xl md:text-2xl lg:text-3xl">
               a computer graphics student at UPenn, driven by a deep love for visual storytelling and the tools that bring it to life. 
               I enjoy exploring the intersection of art and code—whether that's proceduralism, music animations, or stylization. 
               My dream is to contribute to animated feature films, where creative problem solving can elevate emotion, story, and craft.
             </p> -->
             <p class="mt-4 outfit text-xl md:text-2xl lg:text-3xl">
               a third-year student in the 
               <a href="https://cg.cis.upenn.edu/dmd.html" target="_blank" rel="noopener noreferrer" class="hover:underline">Digital Media Design</a> 
               program at UPenn studying 
               <a href="https://en.wikipedia.org/wiki/Computer_graphics_(computer_science)" target="_blank" rel="noopener noreferrer"class="hover:underline">computer graphics</a>. 
             </p>

              <p class="mt-6 outfit text-base md:text-lg lg:text-xl">
                 I grew up learning to code in school, and made art in my free time, so I'm interested in everything within graphics: geometry, rendering, animation... forever learning!
              </p>

              <p class="mt-3 outfit text-base md:text-lg lg:text-xl">
               Outside of classes, I TA for computer graphics (before that, discrete math), and I run public relations as part of the CG@Penn student board.
             </p>

             <p class="mt-3 outfit text-base md:text-lg lg:text-xl">
               Last summer, I interned at NASA and worked on autonomous drone traffic management. Before that, I was working in an origami robotics research lab.
             </p>

             <p class="mt-3 outfit text-base md:text-lg lg:text-xl">
               I also fold origami, run, play table tennis and ultimate frisbee, watch tv, make videos, and hike.
             </p>

             <p class="mt-3 outfit text-base md:text-lg lg:text-xl">
              Other things I like: The Strokes, Hans Zimmer, How to Train Your Dragon, Whiplash, Andor, Avatar: the Last Airbender, Outer Wilds, Splatoon.
             </p>

             <p class="mt-8 outfit text-base md:text-lg lg:text-xl">
                  Thanks for stopping by! You can email me at: 
                  <a id="email-container" href="#" class="hover:underline">
                      Enable JavaScript to view email
                  </a>
              </p>
           </Card>
       </div>
    </section>
    <RecentBlogPosts />
    
    <!-- <section id='others' class='grid md:grid-cols-8 gap-8 mt-4'>
        <div class='col-span-full'>
           <Card>
             <h2 class="text-3xl font-bold mb-4">Hello, I'm Zachary</h2>
             <p class="text-lg">
               I'm a 3D artist and software enthusiast, passionate about bringing ideas to life
               through creative means.
             </p>
           </Card>
       </div>
    </section> -->
  </main>
  <script define:vars={{ email }}>
    document.addEventListener('astro:page-load', () => {
      const emailLink = document.getElementById('email-container');
      if (emailLink) {
        emailLink.textContent = email;
        emailLink.href = "mailto:" + email;
      }
    });
  </script>
</Layout>
